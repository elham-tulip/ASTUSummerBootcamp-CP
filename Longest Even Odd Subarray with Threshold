class Solution:
    def longestAlternatingSubarray(self, nums: list[int], threshold: int) -> int:
        longest = 0
        length = 0
        
        for i in range(len(nums)):
            if nums[i] > threshold:
                length = 0  
            elif length > 0 and nums[i] % 2 != nums[i - 1] % 2:
                length += 1
            elif nums[i] % 2 == 0:
                length = 1
            else:
                length = 0
                
            longest = max(longest, length)
            
        return longest
